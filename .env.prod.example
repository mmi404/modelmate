# Copy to /opt/modelmate/.env on the VPS. Never commit the real file.
# Consumed by docker-compose.prod.yml.

# --- Public origin -------------------------------------------------------
SITE_URL=https://modelmate.mmi404.com

# --- Images (set by CI to the commit SHA; default is :latest) -----------
BACKEND_IMAGE=ghcr.io/mmi404/modelmate-backend:latest
FRONTEND_IMAGE=ghcr.io/mmi404/modelmate-frontend:latest

# --- Database ----------------------------------------------------------
POSTGRES_DB=modelmate
POSTGRES_USER=modelmate
POSTGRES_PASSWORD=CHANGE_ME_long_random

# --- Auth ------------------------------------------------------------
# Must be >= 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_at_least_32_bytes_base64
JWT_TTL_MINUTES=1440

# --- Local port bindings (127.0.0.1 only; the shared Caddy proxies these) ---
FRONTEND_PORT=3000
BACKEND_PORT=8080

# --- Email (password reset). Leave MAIL_ENABLED=false until a provider is wired.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@modelmate.mmi404.com

# --- Bot protection (Cloudflare Turnstile) ---------------------------
SECURITY_CAPTCHA_ENABLED=false
TURNSTILE_SECRET=

# --- Only needed with `docker compose --profile edge` (dedicated Caddy) ---
SITE_DOMAIN=modelmate.mmi404.com
ACME_EMAIL=admin@mmi404.com
