# Copy to .env.local for local development. Never commit .env.local.
# Next.js only reads env files from this directory (frontend/), not the repo root.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: used by Server Components/Route Handlers to call the backend
# directly. In prod (Docker) this is the backend service's container name,
# e.g. http://backend:8080.
BACKEND_INTERNAL_URL=http://localhost:8080

# Cloudflare Turnstile site key (public). Leave blank while
# modelmate.security.captcha.enabled=false on the backend.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
