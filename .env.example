# Copy to .env for local development.  Never commit .env.

# --- Postgres (docker-compose.yml) ---
# Port 5433 on the host to avoid clashing with other local Postgres instances.
POSTGRES_DB=modelmate
POSTGRES_USER=modelmate
POSTGRES_PASSWORD=modelmate
POSTGRES_PORT=5433

# --- Backend (Spring Boot, profile=dev) ---
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5433/modelmate
DB_USER=modelmate
DB_PASSWORD=modelmate
JWT_SECRET=dev-only-change-me-to-a-long-random-string-at-least-32-bytes
JWT_TTL_MINUTES=1440
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@modelmate.local
SECURITY_CAPTCHA_ENABLED=false
TURNSTILE_SECRET=

# --- Frontend (Next.js) ---
# Next.js reads env vars from frontend/.env.local, not this file — see
# frontend/.env.example. Listed here too so the whole stack's config is
# visible from one place.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
